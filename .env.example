# ============================================================================
#  Saanshika Ethnics — environment
#
#  Copy to `.env.local` for development and set the same keys in the Vercel
#  project settings for production. `.env.local` is gitignored; this file is
#  the checked-in record of *which* keys exist, never of their values.
# ============================================================================

# ── InsForge (database, auth, storage, transactional email) ─────────────────
# Both are public by design — the anon key is shipped to the browser and RLS
# is what actually protects the data. Defaults in lib/insforge-client.ts point
# at the live project, so these are only needed to target a different backend.
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# ── Shiprocket ──────────────────────────────────────────────────────────────
# Required. Without these, orders are still taken and saved but no shipment is
# created: the order is marked `NOT PUSHED: Shiprocket credentials not
# configured` and the checkout serviceability check reports `unknown`.
# Use the API-user credentials from Settings → API → Configure in Shiprocket,
# not your dashboard login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# The pickup address, exactly as named in Shiprocket → Settings → Pickup
# Addresses. A name that does not exist there makes every order create fail.
SHIPROCKET_PICKUP_LOCATION=Primary
# Origin pincode for courier serviceability and rate quotes.
SHIPROCKET_PICKUP_PINCODE=143001

# Declared parcel size. The products table carries no weight or dimensions, so
# one flat garment-sized parcel is assumed and the weight multiplied by the
# number of units. Couriers re-weigh at pickup and reconcile, so a rough
# figure only affects the initial rate estimate.
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=30
SHIPROCKET_DEFAULT_BREADTH_CM=25
SHIPROCKET_DEFAULT_HEIGHT_CM=5

# ── Razorpay ────────────────────────────────────────────────────────────────
# KEY_ID is public (it goes into the browser checkout); KEY_SECRET signs and
# verifies payments server-side and must never be exposed.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Cloudinary (product and banner image uploads) ───────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
